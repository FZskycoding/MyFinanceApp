@model IEnumerable<MyFinanceApp.Models.Expense>

<h2>我的消費</h2>
<a href="@Url.RouteUrl("default", new { controller = "Expenses", action = "Create" })" class="btn btn-primary">新增支出</a>


<div class="container">
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>內容</th>
                <th>價格</th>
                <th>類別</th>
                <th>日期</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.Amount $</td>
                    <td>@item.Category</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>

</div>

<h2>消費總覽</h2>
<div>
    <canvas style="max-width:450px ; max-height:450px" id="myChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('myChart');

    fetch('/Expenses/GetChart').then(response => response.json())
                                            .then(data =>{
                                                new Chart(ctx, {
                                                          type: 'pie',
                                                          data: {
                                                            labels: data.map(d=>d.category),
                                                            datasets: [{
                                                              data: data.map(d=>d.total),
                                                            }]
                                                          },
                                                });
                                            })
</script>